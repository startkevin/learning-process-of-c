题目要求：编写一个能实现对学生信息进行管理，实现创建学生信息文件，编辑学生信息，输出显示学生信息3个功能的程序。
代码实现：
#include<iostream>
#include<iomanip>
#include<fstream>
using namespace std;
//定义一个学生结构体
struct Info {
	char name[21];
	int age;
	char address[51];
	char phone[14];
	char email[51];
};
void createFile(fstream &);//创建学生信息文件
void editFile(fstream&);//编辑学生信息文件
void showFile(fstream&);//显示输出学生信息文件

//编写第一个函数：create函数
void createFile(fstream& File) {
	Info  students[5];//定义一个结构体数组
	for (int i = 0; i < 5; i++) {
		cout << "请输入学生姓名：" << endl;
		cin >> students[i].name;
		cout << "请输入学生年龄" << endl;
		cin >> students[i].age;
		cout << "请输入学生地址" << endl;
		getline(cin, students[i].address);//考虑到有的时候地址会包含空格的情况
		cout << "请输入学生电话号码" << endl;
		cin >> students[i].phone; 
		cout << "请输入学生邮箱地址" << endl;
		cin >> students[i].email;
	}
	//手动填充完了5个学生的信息结构体，接下来我们需要逐步把他们写入文件中，以此来完成信息文件的创建
	for (int i = 0; i < 5; i++) {
		cout << "向文件中写入信息" << endl;
		file.write((char*)&students[i], sizeof(students));
	}
	file.flush();//将缓冲区数据强制写入磁盘中，防止重要程序丢失。
	//当你向文件中写入数据时为了效率，数据不会立刻写入硬盘，而是会在缓冲区内暂放，这个个操作相当于强制出发数据存档，防止数据丢失
}


//编写第二个函数：eidt函数
//首先我们需要明确该函数实现的逻辑：1.将原信息读出来存入新的结构体2.对该结构体的内容进行修改 3.再用该结构体覆写掉源文件中的结构体
void editFile(fstream &file) {
	Info person;//首先我们需要一个同类型的结构体来做修改的载体
	long num;//用于检索我们想要修改几号学生的信息，用long是因为他所能包含的数据量更大

	file.clear();//特别注意只要是前面打开过操作过的文件在进行新的处理之前一定要进行clear做状态位的复原
	cin >> num;
	cin.ignore();//这种cin后面由于要接一个cin.getline也要cin.ignore。。。。。
	//由于该函数只接收了文件file，不可能读到原有的student[]!所以我们的思路应该是直接从f中读取person再对person进行修改
	file.seekg((num-1)*sizeof(Info),ios::beg);
	file.read((char*)&person, sizeof(person));
	cout << "学生姓名为：" << person.name << endl;    //显示原有该项信息
	cin.getline(person.name,21);    //读入新的结构体中
	cout << "学生年龄为：" << person.age << endl;
	cin >> person.age;     //年龄是int类型的！不能用 getline(person.age, 20);！
	cin.ignore();         //关键是在cin>>后面使用getline的时候中间必须加cin.ignore()清除cin在缓冲区留下的换行符
	cout << "学生地址为：" << person.address<< endl;
	cin.getline(person.address,51);   //从键盘上获取新的修改信息要加cin.的前缀在getline前
	cout << "学生电话号码为：" << person.phone << endl;
	cin.getline( person.phone,50);
	cout << "学生邮箱地址为：" << person.email << endl;
	cin.getline(person.email,50);

	//利用定位将更新信息的结构体传回原文件覆写原结构体
	file.seekp((num-1)* (sizeof(Info)), ios::beg);
	file.write((char*)&person, sizeof(person));
	file.flush();

}

//编写第三个函数：showFile函数
void showFile(fstream& f) {
	Info record = {" ",0," "," "," "};//我们创建一个结构体作为输出的载体，并且初始化它
	f.clear();//即将读取文件，要先清理掉之前函数可能影响的文件的标志位。
	f.seekg(0L, ios::beg);//重置光标到文件开头
	while (f.read((char*)&record, sizeof(record));) {//如果还是用f.eof()容易导致多输出一次的问题
		//打开文件并开始一个结构体一个结构体的读,我发现你很容易忽略一个信息就是这个句子的语义是从f中读取，并存到record的地址中
		if (f.fail()) {
			exit(0);
		}
		cout << "姓名" << record.name << endl;
		cout << "年龄" << record.age<< endl;
		cout << "住址" << record.address << endl;
		cout << "电话号码" << record.phone << endl;
		cout << "邮箱地址" << record.email << endl;
	}
}


int main() {
	int choice;//相当于菜单的动态按键
	fstream people("Info.dat", ios::in | ios::out | ios::binary);//打开文件，进行操作
