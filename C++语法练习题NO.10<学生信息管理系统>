		cout << "打开文件失败" << endl;
		exit(0);
	}
	//来啦！要学会怎么写菜单！
	while (true) {
		cout << "\n\t 1.Create 2.Show 3.Edit 4.Exit \n";//\n为换行符，\t即在新行的开头空出一段距离（通常为4个或8个空格）
		cin >> choice;//为4个操作的序号
		sitwch(choice) {
		case 1: ctreateFile(people);//相应序号对应相应操作对应相应函数，创建学生信息文件
			    break;
		case 2: editFile(people);
			    break;
		case 3: showFile(people);
			    break;
		case 4: exit(0);//exit(0)不仅仅是一个标识符而是一个能直接终止程序的函数
		
