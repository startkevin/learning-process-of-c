二分搜索
1）解决在有序数组中查找num是否存在
***方法实现： eg.[1，3，5，9，11，13，23，25] 目标数字key=5
        对应位置：0  1  2  3  4   5   6  7  找到中位（0+7）/2向下取整为3位置的9
   判断key是>9还是<9  ————> 决定在数组前半段查找还是在后半段，接着重复以上步骤
   .....继续在1/2中判断是前半段还是后半段，同样找中位并向下取整。
   
*** 代码实现：
#include<stdbool.h>
//注意必须要确保arr有序才能使用这个方法
bool exist(int arr[],int len,int num){ //特别注意导入形参的数组形式写法,num为目标数字
         //i)数组为空或长度为0
         if(arr==NULL||len==0){
            return false;
         }
         //引入3个指针角标索引
         int l=0,r=len-1,m=0;  //特别说明：l为左边界索引，开始时指向数组的第一个元素
                                          r为右边界索引，开始时指向数组的最后一个元素
                                          m为中间索引，用于储存每次计算出来的中点位置
         //ii)若数组元素个数>=1
         while(l<=r){ //需保证左边界在右界左边才查找（l和r是动态的），注意有等号！
              m=1+((r-1)>>1);  //相当于（1+r）/2
              //判断中点元素与目标值关系
              if(arr[m]==num){//直接找到目标值
              return true;
              }else if(arr[m]>num){ //中点值>num-----num应该在左边
                    r=m-1;//调整右边界到中点左侧
              }else{ //在右边的情况
                    l=m+1;//调整左边界到中点右侧
              }              
         }
         return false;//循环结束仍未找到，查找失败。
}
