//第四个函数：预定函数
void bookRoom(fstream& f) {
	char aimId[10];
	cin >> aimId;
	Info temp;
	int n = 0;
	bool found=false;//在这里加一个bool值用来检测是否找到对应房间
	while (f.read((char*)&temp, sizeof(Info))) {
		if (strcmp(temp.id, aimId) == 0) {//比较字符串用这个函数==0;不要直接等号相等
			found = 1; 
			break;		}
		n++;//标记是文件中的第几条记录（第几个结构体）前
	}
	if (found == 0) {
		cout << "未输入正确房间号" << endl;
		return;//加一个return表示终止执行
	}
	if (temp.booked ==true) {
		cout << "房间已经被预定，不能重复预订" << endl;
		return;
	}
	
		temp.booked = true;
		f.seekp(n * sizeof(Info), ios::beg);
		f.write((char*)&temp, sizeof(Info));
		f.flush();//确保预定信息写入磁盘
	
}

//第五个函数：入住函数
void checkInRoom(fstream& f) {
	char aimId[10];
	cin >> aimId;
	Info temp;
	int n = 0;
	bool found = false;
	while (f.read((char*)&temp, sizeof(Info))) {
		if (strcmp(temp.id, aimId) == 0) {//比较字符串用这个函数==0;不要直接等号相等
			found = 1;
			break;
		}
		n++;//标记是文件中的第几条记录（第几个结构体）前
	}
	if (found == 0) {
		cout << "未输入正确房间号" << endl;
		return;//加一个return表示终止执行
	}
	if (temp.checkIn==false) {
		cout << "房间还未预定，需先预定才能入住" << endl;
		return;
	}
	else {
		temp.checkIn = true;
		f.seekp(n * sizeof(Info), ios::beg);
		f.write((char*)&temp, sizeof(Info));
		f.flush();//确保预定信息写入磁盘
	}
}

//第六个函数：查找房号
void findRoom(fstream& f) {//按照姓名查找某个住客房号
	char aimName[10];
	cin >> aimName;
	Info temp;
	int n = 0;
	bool found = false;
	while (f.read((char*)&temp, sizeof(Info))) {
		if (strcmp(temp.cname, aimName) == 0) {//比较字符串用这个函数==0;不要直接等号相等
			found = 1;
			break;
		}
		
	}
	if (found == 0) {
		cout << "未找到相应住客对应房间" << endl;
		return;
	}
	else {
		cout << "对应住客房间号为：" << temp.id << endl;
	}
}

//第七个函数：办理退房
void checkOut(fstream& f) {//办理退房，删除某客房的入住记录
	char aimId[10];
	cin >> aimId;
	Info temp;
	int n = 0;
	bool found = false;
	while (f.read((char*)&temp, sizeof(Info))) {
		if (strcmp(temp.id, aimId) == 0) {//比较字符串用这个函数==0;不要直接等号相等
			found = 1;
			break;
		}
		n++;//标记是文件中的第几条记录（第几个结构体）前
	}
	if (found == 0) {
		cout << "未输入正确房间号" << endl;
		return;//加一个return表示终止执行
	}
	if (temp.booked == false) {
		cout << "房间还未预定，无法进行退房操作" << endl;
		return;
	}
	else {
		temp.booked == false;
		temp.checkIn = false;
		f.seekp(n * sizeof(Info), ios::beg);
		f.write((char*)&temp, sizeof(Info));
		f.flush();//确保预定信息写入磁盘
	}
}


//第八个函数：统计各类房间数量
void countRoom(fstream& f) {//统计文件中的各类房间总数
	Info temp;
	int numOf_checkIn = 0;
	int numOf_book_but_not_checkIn = 0;
	int numOf_empty_room = 0;
	f.clear();
	f.seekg(0L, ios::beg);
	while (f.read((char*)&temp, sizeof(Info))) {
		if (temp.booked == true || temp.checkIn == false) {
			numOf_book_but_not_checkIn++;
		}
		else if (temp.booked == true || temp.checkIn == true) {
			numOf_checkIn++;
		}
		else if (temp.booked == false || temp.checkIn == false) {
			numOf_empty_room++;
		}
	}
	cout << "目前已预定但未入住的房间有：" << numOf_book_but_not_checkIn << "间" << endl;
	cout << "目前已预定且入住入住的房间有：" << numOf_checkIn << "间" << endl;
	cout << "目前未预定的空房间有：" << numOf_empty_room << "间" << endl;
}

